REPORT_ADAPTER=mock
DOWNLOAD_DIR=./downloads
UI_PORT=4173
UI_DEV_MODE=false

# Required only when REPORT_ADAPTER=playwright
TARGET_BASE_URL=https://example.invalid
TARGET_USERNAME=
TARGET_PASSWORD=
# EBAS 人工登入固定有頭、健康檢查固定無頭；下載由任務 browserMode 控制，預設 headed。
HEADLESS=true
# Optional: reuse an existing local Chromium instead of the revision expected by this Playwright package.
# Windows example:
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=C:\Users\chianghz\AppData\Local\ms-playwright\chromium-1223\chrome-win64\chrome.exe

# EBAS 1103 mode
# Set REPORT_ADAPTER=ebas after preparing login session.
EBAS_LOGIN_URL=https://sso.ebas.gov.tw/Account/Login?ReturnUrl=%2Fconnect%2Fauthorize%2Fcallback%3Fresponse_type%3Dcode%26client_id%3DId_80f2567f55b64813a57c8c5f8781769b%26state%3Drelese%26redirect_uri%3Dhttps%253A%252F%252Febasnew.ebas.gov.tw%252Flogin%252FVerify%26scope%3Demail%2520openid%2520profile
EBAS_ENTRY_URL=https://ebasnew.ebas.gov.tw/SSO/ToLink/0/1103
EBAS_STORAGE_STATE=./.auth/ebas-storage-state.json
EBAS_DEBUG_DIR=./debug/ebas
EBAS_PRINT_CLICK_TIMEOUT_MS=30000
EBAS_DOWNLOAD_TIMEOUT_MS=60000
EBAS_UI_IDLE_TIMEOUT_MS=60000
EBAS_PRE_PRINT_NETWORK_IDLE_TIMEOUT_MS=5000
SLOW_MO=300

# Optional default recipient for the in-app issue report form
AUTOMATION_STUDIO_SUPPORT_EMAIL=

# Optional AI Provider credentials (V1.0.7)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Corporate TLS inspection: point to a PEM file containing the trusted Root/Intermediate CA chain.
# Must be set before Node starts. Example:
# NODE_EXTRA_CA_CERTS=D:\AI\certs\company-ca-chain.pem
# NODE_USE_SYSTEM_CA=1 is already enabled by start.bat when not otherwise specified.
